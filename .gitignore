# SHARED by .frontend.git and .backend.git: only what NEITHER repository tracks.
# Each repository's own list is in frontend.gitignore / backend.gitignore,
# copied into .frontend.git/info/exclude and .backend.git/info/exclude.

# The two Git folders
.frontend.git/
.backend.git/

# Installs, builds and secrets
node_modules/
build/
.env
secret.*
*secret.*
__pycache__/

# Written by webpack next to the bundle
public/*.LICENSE.txt

# Compiled twins nobody tracks
source/layouts/containers/**/*.jsx

# Editors and operating systems
bin
.~*
.wsuo
.idea
*.ini
.hidden
.directory
DocumentLayout.json
VSWorkspaceState.json

# Claude Code and its sandbox
.zshrc
.claude
.bashrc
.profile
.mcp.json
.zprofile
.gitconfig
.ripgreprc
.gitmodules
.bash_profile
.claude-notes
