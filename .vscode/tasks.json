{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pull both repositories",
      "detail": "AI Code: Review Please 2026-11-24 · sync.js pull, called directly because it is not on the npm menu. Pulls both repositories, fast-forward only, and shows where each stands. Never commits or pushes. A failed pull (offline, or a change in the way) only warns, so the app still starts.",
      "type": "shell",
      "command": "node source/modules/guards/sync.js pull",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "linux": {
        "command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && node source/modules/guards/sync.js pull; true",
        "options": {
          "shell": {
            "executable": "/bin/bash",
            "args": ["-c"]
          }
        }
      },
      "windows": {
        "command": "node source/modules/guards/sync.js pull & exit /b 0",
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "osx": {
        "command": "node source/modules/guards/sync.js pull; true"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "npm run launch",
      "type": "shell",
      "command": "npm run launch",
      "dependsOn": "Pull both repositories",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "linux": {
        "command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && npm run launch",
        "options": {
          "shell": {
            "executable": "/bin/bash",
            "args": ["-c"]
          }
        }
      },
      "windows": {
        "command": "npm run launch",
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
