{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["source/", "source/layouts/pages/*", "source/layouts/styles/*"],
  "exclude": ["node_modules/", "source/**/REVIEW/", "source/utilities/vendors/archive/log-a-ticket/", "source/utilities/vendors/archive/university-tracker/"]
}
