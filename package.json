{
  "name": "tralogfin",
  "version": "1.0.0",
  "description": "TraLogFin: Track a Day, Log a Ticket and Find a Link. One folder, two repositories: development-portfolio_4.00 (public) and backend-architecture_2.00 (private).",
  "private": true,
  "workspaces": [
    "source/layouts",
    "source/modules"
  ],
  "scripts": {
    "app": "npm run launch",
    "launch": "webpack-dev-server --mode development",
    "deploy": "webpack --mode production",
    "stop": "npx kill-port 8080",
    "guard": "gulp guard",
    "server": "node source/modules/server/index.js",
    "export": "node source/modules/server/export.js",
    "setup": "node setup.js"
  },
  "author": "Tertius Roach",
  "license": "ISC"
}
